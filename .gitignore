# =============================================
# BrandGuard.ai — root .gitignore
# =============================================

# Environment / secrets — NEVER commit
.env
.env.local
.env.*.local
*.env

# Python virtualenvs
backend/.venv/
backend/venv/
.venv/
venv/

# Python bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/
*.xml
*.log

# Uploaded user files (runtime artifacts)
backend/uploads/

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend_tmp/

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.suo
*.user

# Docker volumes
db/

# Distribution / build
dist/
build/
*.egg-info/

