# =============================================
# BrandGuard.ai — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials.
# =============================================

# --- Application ---
APP_ENV=development

# --- Auth ---
# Must be at least 32 random characters. Production startup refuses if absent.
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
AUTH_TOKEN_TTL_MINUTES=60

# --- Database ---
# PostgreSQL connection string. Must have the pgvector extension installed.
# For local Docker Compose: postgresql://brandguard:brandguard@localhost:5432/brandguard
# For Neon (cloud): postgresql+psycopg2://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://brandguard:brandguard@localhost:5432/brandguard

# --- LLM / AI Provider ---
# Supports any OpenAI-compatible API (OpenAI, Groq, Together, etc.)
# Leave LLM_API_KEY empty to skip AI checks and run deterministic-only mode.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- CORS / Frontend ---
FRONTEND_ORIGIN=http://localhost:3000

# --- File Uploads ---
UPLOAD_DIR=uploads
